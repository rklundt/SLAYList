engine-strict=true
auto-install-peers=true

# pnpm's strict node_modules layout doesn't expose every package at the
# repo root. A few CLI tools expect to find their packages there via
# Node's classic resolution. Public-hoist those specific packages while
# keeping the strict layout for everything else.
#   - azure-functions-core-tools: the SWA CLI's `swa start` does a
#     hardcoded `require('<root>/azure-functions-core-tools/lib/main.js')`
#     to launch the local func runtime; without hoisting, it errors with
#     `Cannot find module`. Discovered during Sprint 0.3 dev verification.
public-hoist-pattern[]=azure-functions-core-tools
